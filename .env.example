# Public URL of the deployed site (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://unitydevdigital.com

# Contact form delivery via Resend (https://resend.com). Without RESEND_API_KEY,
# submissions are logged to the server console in development and rejected
# with a friendly "email us directly" message in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@unitydevdigital.com
# Must be an address on a domain verified in Resend
CONTACT_FROM_EMAIL="UnityDev Digital <website@unitydevdigital.com>"
